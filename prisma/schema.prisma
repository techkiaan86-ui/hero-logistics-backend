model VinScanEvent {
  id String @id @default(uuid())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  loadId String
  load   Load   @relation(fields: [loadId], references: [id])

  loadItemId String?
  loadItem   LoadItem? @relation(fields: [loadItemId], references: [id])

