// ----------------------------------------------------------------------
// DRIVER PORTAL: TRAILER / EQUIPMENT SWAP
// ----------------------------------------------------------------------

model EquipmentSwap {
  id String @id @default(uuid())

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  prevTrailerId String?
  prevTrailer   Vehicle? @relation("PrevTrailerSwap", fields: [prevTrailerId], references: [id])

  newTrailerId String?
  newTrailer   Vehicle? @relation("NewTrailerSwap", fields: [newTrailerId], references: [id])

